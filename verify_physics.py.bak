"""
Independent first-principles verification harness (REFINEMENT, 2026-06-13).
=========================================================================
Recomputes every headline number from physics, INDEPENDENTLY of the
production modules, and compares against (a) the production code and
(b) the manuscript claims. Built because a 13x error was found in the
advanced-exergy engine model; per user instruction, NOTHING is trusted
until re-derived here.

Run: python verify_physics.py
No external state is written; prints a verdict table. Local-only (no API).
"""
from __future__ import annotations
import numpy as np
import CoolProp.CoolProp as CP
from engine_model import S65MEC_Engine

LOADS = [0.50, 0.75, 0.85, 1.00]
T0_C = 29.0
T0 = T0_C + 273.15           # dead state = seawater 29 C
PHI_HFO = 1.06               # chemical exergy / LHV for HFO

def carnot_stream(Q_kW, T_hot_K, T_cold_K=T0):
    """Exergy of a sensible-heat stream cooling T_hot->T_cold (log-mean)."""
    if T_hot_K <= T_cold_K:
        return 0.0
    dT = T_hot_K - T_cold_K
    lm = 1.0 - T0 * np.log(T_hot_K / T_cold_K) / dT
    return Q_kW * max(lm, 0.0)

def isothermal_exergy(Q_kW, T_K):
    return Q_kW * max(1.0 - T0 / T_K, 0.0)

# ---- best-in-class "unavoidable" engine reference ------------------------
# Real S65ME-C brake efficiency ~0.507. Best realistically attainable large
# 2-stroke (de-rated, optimized injection, low-NOx, improved insulation) is
# taken at eta_brake = 0.540 (state of the art ~2024 G/S-type bare engine).
# The unavoidable engine destruction is what remains at that best state.
ETA_BRAKE_BEST = 0.540

def engine_exergy_balance(engine, load, eta_brake=None):
    """Full whole-engine (cylinder+TC+heat transfer) exergy balance.
    Returns dict of exergy terms (kW). If eta_brake given, overrides the
    real brake efficiency to model a best-in-class 'unavoidable' engine."""
    Q_fuel = float(engine.fuel_energy_input(load))
    Ex_fuel = Q_fuel * PHI_HFO
    if eta_brake is None:
        W_brake = float(engine.brake_power(load))
    else:
        W_brake = eta_brake * Q_fuel
    # Heat-rejection streams (energy) and their representative reject temps
    Q_exh = float(engine.exhaust_heat(load, T_ref_C=T0_C))     # post-TC, above dead state
    T_exh_K = float(engine.exhaust_gas_temp_after_TC(load)) + 273.15
    Q_jac = float(engine.jacket_water_heat(load));    T_jac_K = 85.0 + 273.15
    Q_chg = float(engine.charge_air_heat(load));      T_chg_K = 130.0 + 273.15  # glide ~200->60, repr mean
    Q_lub = float(engine.lube_oil_heat(load));        T_lub_K = 60.0 + 273.15
    Q_rad = float(engine.radiation_loss(load));       T_rad_K = 50.0 + 273.15
    Ex_exh = carnot_stream(Q_exh, T_exh_K)
    Ex_jac = isothermal_exergy(Q_jac, T_jac_K)
    Ex_chg = carnot_stream(Q_chg, T_chg_K)
    Ex_lub = isothermal_exergy(Q_lub, T_lub_K)
    Ex_rad = isothermal_exergy(Q_rad, T_rad_K)
    Ex_heat = Ex_exh + Ex_jac + Ex_chg + Ex_lub + Ex_rad
    E_D = Ex_fuel - W_brake - Ex_heat
    return dict(Q_fuel=Q_fuel, Ex_fuel=Ex_fuel, W_brake=W_brake,
                Ex_exh=Ex_exh, Ex_jac=Ex_jac, Ex_chg=Ex_chg, Ex_lub=Ex_lub,
                Ex_rad=Ex_rad, Ex_heat=Ex_heat, E_D=E_D,
                eta_ex=W_brake/Ex_fuel, dest_frac=E_D/Ex_fuel)

print("="*78)
print("STAGE 1 — ENGINE / COMBUSTION EXERGY (corrected first-principles balance)")
print("="*78)
eng = S65MEC_Engine(ambient_temp_C=30, seawater_temp_C=29)
print(f"{'load':>5} {'Ex_fuel':>8} {'W_brake':>8} {'Ex_exh':>7} {'Ex_heat':>7} "
      f"{'E_D_tot':>8} {'eta_ex':>6} {'dest%':>6} | {'E_D_unav':>8} {'E_D_av':>7} {'av%':>5}")
for L in LOADS:
    r = engine_exergy_balance(eng, L)
    u = engine_exergy_balance(eng, L, eta_brake=ETA_BRAKE_BEST)
    e_d_unav = min(u['E_D'], r['E_D'])
    e_d_av = max(r['E_D'] - e_d_unav, 0.0)
    av_pct = 100*e_d_av/r['E_D']
    print(f"{L:5.2f} {r['Ex_fuel']:8.0f} {r['W_brake']:8.0f} {r['Ex_exh']:7.0f} "
          f"{r['Ex_heat']:7.0f} {r['E_D']:8.0f} {r['eta_ex']:6.3f} {100*r['dest_frac']:6.1f} | "
          f"{e_d_unav:8.0f} {e_d_av:7.0f} {av_pct:5.1f}")

print()
print("OLD (production 07_*.csv) engine_cylinder at 85%: total=1227.8, unav=0, av=1227.8")
print("Manuscript claim: engine destruction 42.5% of fuel exergy; eta_ex bare engine 47.9%")
