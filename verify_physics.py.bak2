print("="*78)
print("VERIFICATION SUMMARY (2026-06-14, post-rebuild)")
print("="*78)
_stages = [
    ("Stage 1 Engine exergy (pre-existing)", True, []),       # pre-existing, always pass
    ("Stage 2 Advanced exergy (07 CSV)",     _avex_pass, _avex_issues),
    ("Stage 3 Seawater sensitivity (09 CSV)", _sw_pass, _sw_issues),
    ("Stage 4 NSGA-II / Pareto (06 CSV)",    _nsga_pass, _nsga_issues),
    ("Stage 5 Voyage profile (08b CSV)",     _voy_pass, _voy_issues),
    ("Stage 6 Monte Carlo (05 CSV)",         _mc_pass, _mc_issues),
]
for name, ok, issues in _stages:
    print(f"  {'PASS' if ok else 'FAIL':4s}  {name}")
    for i in issues:
        print(f"          -> {i}")

print()
