"""
Independent first-principles verification harness (REFINEMENT, 2026-06-13).
=========================================================================
Recomputes every headline number from physics, INDEPENDENTLY of the
production modules, and compares against (a) the production code and
(b) the manuscript claims. Built because a 13x error was found in the
advanced-exergy engine model; per user instruction, NOTHING is trusted
until re-derived here.

Run: python verify_physics.py
No external state is written; prints a verdict table. Local-only (no API).
"""
from __future__ import annotations
import numpy as np
import CoolProp.CoolProp as CP
from engine_model import S65MEC_Engine

LOADS = [0.50, 0.75, 0.85, 1.00]
T0_C = 29.0
T0 = T0_C + 273.15           # dead state = seawater 29 C
PHI_HFO = 1.06               # chemical exergy / LHV for HFO

def carnot_stream(Q_kW, T_hot_K, T_cold_K=T0):
    """Exergy of a sensible-heat stream cooling T_hot->T_cold (log-mean)."""
    if T_hot_K <= T_cold_K:
        return 0.0
    dT = T_hot_K - T_cold_K
    lm = 1.0 - T0 * np.log(T_hot_K / T_cold_K) / dT
    return Q_kW * max(lm, 0.0)

def isothermal_exergy(Q_kW, T_K):
    return Q_kW * max(1.0 - T0 / T_K, 0.0)

# ---- best-in-class "unavoidable" engine reference ------------------------
# Real S65ME-C brake efficiency ~0.507. Best realistically attainable large
# 2-stroke (de-rated, optimized injection, low-NOx, improved insulation) is
# taken at eta_brake = 0.540 (state of the art ~2024 G/S-type bare engine).
# The unavoidable engine destruction is what remains at that best state.
ETA_BRAKE_BEST = 0.540

def engine_exergy_balance(engine, load, eta_brake=None):
    """Full whole-engine (cylinder+TC+heat transfer) exergy balance.
    Returns dict of exergy terms (kW). If eta_brake given, overrides the
    real brake efficiency to model a best-in-class 'unavoidable' engine."""
    Q_fuel = float(engine.fuel_energy_input(load))
    Ex_fuel = Q_fuel * PHI_HFO
    if eta_brake is None:
        W_brake = float(engine.brake_power(load))
    else:
        W_brake = eta_brake * Q_fuel
    # Heat-rejection streams (energy) and their representative reject temps
    Q_exh = float(engine.exhaust_heat(load, T_ref_C=T0_C))     # post-TC, above dead state
    T_exh_K = float(engine.exhaust_gas_temp_after_TC(load)) + 273.15
    Q_jac = float(engine.jacket_water_heat(load));    T_jac_K = 85.0 + 273.15
    Q_chg = float(engine.charge_air_heat(load));      T_chg_K = 130.0 + 273.15  # glide ~200->60, repr mean
    Q_lub = float(engine.lube_oil_heat(load));        T_lub_K = 60.0 + 273.15
    Q_rad = float(engine.radiation_loss(load));       T_rad_K = 50.0 + 273.15
    Ex_exh = carnot_stream(Q_exh, T_exh_K)
    Ex_jac = isothermal_exergy(Q_jac, T_jac_K)
    Ex_chg = carnot_stream(Q_chg, T_chg_K)
    Ex_lub = isothermal_exergy(Q_lub, T_lub_K)
    Ex_rad = isothermal_exergy(Q_rad, T_rad_K)
    Ex_heat = Ex_exh + Ex_jac + Ex_chg + Ex_lub + Ex_rad
    E_D = Ex_fuel - W_brake - Ex_heat
    return dict(Q_fuel=Q_fuel, Ex_fuel=Ex_fuel, W_brake=W_brake,
                Ex_exh=Ex_exh, Ex_jac=Ex_jac, Ex_chg=Ex_chg, Ex_lub=Ex_lub,
                Ex_rad=Ex_rad, Ex_heat=Ex_heat, E_D=E_D,
                eta_ex=W_brake/Ex_fuel, dest_frac=E_D/Ex_fuel)

print("="*78)
print("STAGE 1 — ENGINE / COMBUSTION EXERGY (corrected first-principles balance)")
print("="*78)
eng = S65MEC_Engine(ambient_temp_C=30, seawater_temp_C=29)
print(f"{'load':>5} {'Ex_fuel':>8} {'W_brake':>8} {'Ex_exh':>7} {'Ex_heat':>7} "
      f"{'E_D_tot':>8} {'eta_ex':>6} {'dest%':>6} | {'E_D_unav':>8} {'E_D_av':>7} {'av%':>5}")
for L in LOADS:
    r = engine_exergy_balance(eng, L)
    u = engine_exergy_balance(eng, L, eta_brake=ETA_BRAKE_BEST)
    e_d_unav = min(u['E_D'], r['E_D'])
    e_d_av = max(r['E_D'] - e_d_unav, 0.0)
    av_pct = 100*e_d_av/r['E_D']
    print(f"{L:5.2f} {r['Ex_fuel']:8.0f} {r['W_brake']:8.0f} {r['Ex_exh']:7.0f} "
          f"{r['Ex_heat']:7.0f} {r['E_D']:8.0f} {r['eta_ex']:6.3f} {100*r['dest_frac']:6.1f} | "
          f"{e_d_unav:8.0f} {e_d_av:7.0f} {av_pct:5.1f}")

print()
print("OLD (production 07_*.csv) engine_cylinder at 85%: total=1227.8, unav=0, av=1227.8")
print("Manuscript claim: engine destruction 42.5% of fuel exergy; eta_ex bare engine 47.9%")

# ============================================================================
# STAGE 2 — ADVANCED EXERGY MODULE (07_advanced_exergy_decomposition.csv)
# Independent adversarial verification of the rebuilt advanced_exergy_model.py
# Checks: AV+UN=total, EN+EX=total, AV<=total, UN<=total at EVERY row;
# engine cylinder @85% ~16.3 MW / ~94% unavoidable; shares sum to 100%.
# ============================================================================
import os, sys
import pandas as pd

RESULTS = os.path.join(os.path.dirname(__file__), "results")

print()
print("="*78)
print("STAGE 2 — ADVANCED EXERGY: arithmetic consistency + headline numbers")
print("="*78)

_avex_pass = True
_avex_issues = []

try:
    avex = pd.read_csv(os.path.join(RESULTS, "07_advanced_exergy_decomposition.csv"))

    # --- Check 1: AV + UN == total (tolerance 0.1 kW for floating point) ---
    avex["_av_un_err"] = (avex["E_D_avoidable_kW"] + avex["E_D_unavoidable_kW"]
                         - avex["E_D_total_kW"]).abs()
    max_av_un_err = avex["_av_un_err"].max()
    av_un_ok = max_av_un_err < 0.01
    if not av_un_ok:
        _avex_pass = False
        _avex_issues.append(f"AV+UN != total: max error {max_av_un_err:.4f} kW")
    print(f"  [{'PASS' if av_un_ok else 'FAIL'}] AV + UN == total (max err {max_av_un_err:.6f} kW)")

    # --- Check 2: EN + EX == total ---
    avex["_en_ex_err"] = (avex["E_D_endogenous_kW"] + avex["E_D_exogenous_kW"]
                         - avex["E_D_total_kW"]).abs()
    max_en_ex_err = avex["_en_ex_err"].max()
    en_ex_ok = max_en_ex_err < 0.01
    if not en_ex_ok:
        _avex_pass = False
        _avex_issues.append(f"EN+EX != total: max error {max_en_ex_err:.4f} kW")
    print(f"  [{'PASS' if en_ex_ok else 'FAIL'}] EN + EX == total (max err {max_en_ex_err:.6f} kW)")

    # --- Check 3: AV <= total and UN <= total (no violation) ---
    av_viol = (avex["E_D_avoidable_kW"] > avex["E_D_total_kW"] + 0.01).sum()
    un_viol = (avex["E_D_unavoidable_kW"] > avex["E_D_total_kW"] + 0.01).sum()
    if av_viol > 0:
        _avex_pass = False
        _avex_issues.append(f"AV > total: {av_viol} violations")
    if un_viol > 0:
        _avex_pass = False
        _avex_issues.append(f"UN > total: {un_viol} violations")
    print(f"  [{'PASS' if av_viol==0 else 'FAIL'}] AV <= total ({av_viol} violations)")
    print(f"  [{'PASS' if un_viol==0 else 'FAIL'}] UN <= total ({un_viol} violations)")

    # --- Check 4: AV_EN + AV_EX == AV, UN_EN + UN_EX == UN ---
    avex["_aven_avex_err"] = (avex["E_D_AV_EN_kW"] + avex["E_D_AV_EX_kW"]
                              - avex["E_D_avoidable_kW"]).abs()
    avex["_unen_unex_err"] = (avex["E_D_UN_EN_kW"] + avex["E_D_UN_EX_kW"]
                              - avex["E_D_unavoidable_kW"]).abs()
    cross_av_ok = avex["_aven_avex_err"].max() < 0.01
    cross_un_ok = avex["_unen_unex_err"].max() < 0.01
    if not cross_av_ok:
        _avex_pass = False
        _avex_issues.append(f"AV_EN+AV_EX != AV: max err {avex['_aven_avex_err'].max():.4f} kW")
    if not cross_un_ok:
        _avex_pass = False
        _avex_issues.append(f"UN_EN+UN_EX != UN: max err {avex['_unen_unex_err'].max():.4f} kW")
    print(f"  [{'PASS' if cross_av_ok else 'FAIL'}] AV_EN + AV_EX == AV")
    print(f"  [{'PASS' if cross_un_ok else 'FAIL'}] UN_EN + UN_EX == UN")

    # --- Check 5: Engine cylinder at 85% MCR headline numbers ---
    cyl85 = avex[(avex["Load_pct"].round(0) == 85) &
                 (avex["Component"] == "engine_cylinder")]
    if len(cyl85) == 0:
        _avex_pass = False
        _avex_issues.append("engine_cylinder row at 85% MCR not found")
        print("  [FAIL] engine_cylinder@85% not found")
    else:
        cyl85 = cyl85.iloc[0]
        cyl_tot = cyl85["E_D_total_kW"]
        cyl_unav = cyl85["E_D_unavoidable_kW"]
        cyl_av = cyl85["E_D_avoidable_kW"]
        cyl_unav_frac = 100.0 * cyl_unav / cyl_tot if cyl_tot > 0 else 0
        # Expected after fix (REFINEMENT_FINDINGS.md 2026-06-13):
        #   total ~16 320 kW, unavoidable ~15 345 kW, avoidable ~975 kW
        cyl_tot_ok = 16100 < cyl_tot < 16600
        cyl_unav_frac_ok = cyl_unav_frac > 90   # >90% should be unavoidable (combustion physics)
        cyl_av_ok = 900 < cyl_av < 1100          # ~975 kW avoidable
        for label, val, lo, hi in [
            ("cyl_total",     cyl_tot,       16100, 16600),
            ("cyl_unavoidable", cyl_unav,    14900, 15700),
            ("cyl_avoidable",  cyl_av,         900, 1100),
        ]:
            ok = lo < val < hi
            if not ok:
                _avex_pass = False
                _avex_issues.append(f"engine_cylinder@85% {label}={val:.1f} outside [{lo},{hi}]")
            print(f"  [{'PASS' if ok else 'FAIL'}] engine_cylinder@85% {label} = {val:.1f} kW "
                  f"(expected {lo}–{hi})")
        print(f"         unavoidable fraction = {cyl_unav_frac:.1f}% (must be >90%,"
              f" [{'PASS' if cyl_unav_frac > 90 else 'FAIL'}])")

    # --- Check 6: Component AV-EN shares sum to 100% at every load ---
    for load in avex["Load_pct"].round(0).unique():
        sub = avex[avex["Load_pct"].round(0) == load]
        total_avEN = sub["E_D_AV_EN_kW"].sum()
        shares_sum = (sub["E_D_AV_EN_kW"] / total_avEN * 100).sum() if total_avEN > 0 else 0
        shares_ok = abs(shares_sum - 100.0) < 0.01
        if not shares_ok:
            _avex_pass = False
            _avex_issues.append(f"AV-EN shares at {load:.0f}% sum to {shares_sum:.3f}% != 100%")
        print(f"  [{'PASS' if shares_ok else 'FAIL'}] AV-EN shares@{load:.0f}% MCR sum = "
              f"{shares_sum:.4f}% (need 100%)")

    # --- Note: CANONICAL_FACTS seawater numbers are stale after the rebuild ---
    print()
    print("  NOTE (STALE CANONICAL): engine_cylinder AV_EN 1227.8 kW / 60.3% from")
    print("  CANONICAL_FACTS is the PRE-FIX value. Current CSV: AV_EN=975.3 kW / 52.2%.")
    print("  CANONICAL_FACTS needs update after user sign-off (per hard rules).")
    print()
    print(f"  Stage 2 overall: {'PASS' if _avex_pass else 'FAIL'}")
    if _avex_issues:
        for issue in _avex_issues:
            print(f"    ISSUE: {issue}")

except FileNotFoundError:
    print("  [SKIP] 07_advanced_exergy_decomposition.csv not found")
    _avex_pass = False

# ============================================================================
# STAGE 3 — SEAWATER SENSITIVITY (09_seawater_sensitivity.csv)
# Toluene at 29 C must agree with headline 684 kW (C4 was the failure to agree);
# monotonicity; slope computed from CSV vs canonical 0.76 %/K.
# ============================================================================
print()
print("="*78)
print("STAGE 3 — SEAWATER SENSITIVITY: 29 C alignment, monotonicity, slope")
print("="*78)

_sw_pass = True
_sw_issues = []

try:
    sw = pd.read_csv(os.path.join(RESULTS, "09_seawater_sensitivity.csv"))

    # --- Check 1: Toluene at 29 C must be within 1% of 684 kW ---
    tol29 = sw[(sw["fluid"] == "Toluene") & (sw["T_sw_C"].round(0) == 29)]
    if len(tol29) == 0:
        _sw_pass = False
        _sw_issues.append("Toluene@29C row not found in seawater CSV")
        print("  [FAIL] Toluene@29C row not found")
    else:
        W29 = float(tol29["W_net_kW"].iloc[0])
        eta29 = float(tol29["eta_th"].iloc[0])
        # Canonical headline: 684 kW, 16.5%. Allow ±1%.
        W29_ok = abs(W29 - 684.0) / 684.0 < 0.01
        eta29_ok = abs(eta29 - 0.165) / 0.165 < 0.02   # ±2 pp relative
        if not W29_ok:
            _sw_pass = False
            _sw_issues.append(f"Toluene@29C W_net={W29:.1f} kW (expected 684±1%)")
        if not eta29_ok:
            _sw_pass = False
            _sw_issues.append(f"Toluene@29C eta_th={eta29:.4f} (expected 0.165±2%)")
        print(f"  [{'PASS' if W29_ok else 'FAIL'}] Toluene@29C W_net = {W29:.2f} kW "
              f"(canonical 684 kW, diff {100*(W29-684)/684:+.2f}%)")
        print(f"  [{'PASS' if eta29_ok else 'FAIL'}] Toluene@29C eta_th = {eta29:.4f} "
              f"(canonical 0.165)")

    # --- Check 2: Strict monotone-decreasing W_net for all fluids 15→32 C ---
    for fluid in sw["fluid"].unique():
        sub = sw[sw["fluid"] == fluid].sort_values("T_sw_C")
        diffs = np.diff(sub["W_net_kW"].values)
        mono_ok = np.all(diffs < 0)
        if not mono_ok:
            _sw_pass = False
            _sw_issues.append(f"{fluid}: non-monotone seawater sweep "
                              f"(first violation at T_sw={sub['T_sw_C'].values[np.argmax(diffs>=0)+1]:.0f}C)")
        print(f"  [{'PASS' if mono_ok else 'FAIL'}] {fluid}: strictly monotone decreasing")

    # --- Check 3: Slope from CSV, compare to canonical 0.76 %/K ---
    tol_all = sw[sw["fluid"] == "Toluene"].sort_values("T_sw_C")
    W15 = float(tol_all[tol_all["T_sw_C"].round(0) == 15]["W_net_kW"].iloc[0])
    W32 = float(tol_all[tol_all["T_sw_C"].round(0) == 32]["W_net_kW"].iloc[0])
    derating_pct = 100.0 * (W15 - W32) / W15
    slope_per_K  = derating_pct / 17.0   # 15 → 32 C = 17 K
    # Canonical 0.76 %/K comes from the OLD (wrong) seawater solver.
    # After the rebuild (C4 fix), the slope changed to ~0.82 %/K because the
    # ORCSystem solver gives lower absolute values at all temperatures.
    # We check that slope is physically plausible (0.6 – 1.0 %/K) and
    # explicitly flag the divergence from canonical.
    slope_plaus = 0.60 < slope_per_K < 1.00
    if not slope_plaus:
        _sw_pass = False
        _sw_issues.append(f"Slope {slope_per_K:.3f} %/K is outside plausible range [0.6, 1.0]")
    print(f"  [{'PASS' if slope_plaus else 'FAIL'}] Toluene slope (15→32 C): "
          f"{slope_per_K:.3f} %/K (canonical 0.76 — STALE, see note)")
    print(f"         W(15C)={W15:.1f} kW, W(32C)={W32:.1f} kW, derating={derating_pct:.2f}%")
    print()
    print("  NOTE (STALE CANONICAL): CANONICAL_FACTS seawater section quotes")
    print("  808.2 / 703.6 kW at 15 / 32 C and slope 0.76 %/K. These came from the")
    print("  OLD solver that gave 722 kW at 29 C (C4 defect). The rebuild corrects")
    print("  29 C to 684 kW; the absolute values at 15 C and 32 C changed to")
    f"  {W15:.1f} / {W32:.1f} kW and slope to {slope_per_K:.3f} %/K. CANONICAL_FACTS needs"
    print(f"  updating to {W15:.1f}/{W32:.1f} kW / {slope_per_K:.3f} %/K after user sign-off.")

    print(f"\n  Stage 3 overall: {'PASS' if _sw_pass else 'FAIL'}")
    if _sw_issues:
        for issue in _sw_issues:
            print(f"    ISSUE: {issue}")

except FileNotFoundError:
    print("  [SKIP] 09_seawater_sensitivity.csv not found")
    _sw_pass = False

# ============================================================================
# STAGE 4 — NSGA-II PARETO (06_pareto_front.csv)
# Recount fluid distribution directly from CSV. Verify env objective formula
# (gwp × W_net × 4.0) is consistent. Note that the fluid set was expanded
# per ACTION_PLAN; the canonical "98/100 n-pentane" is now stale.
# ============================================================================
print()
print("="*78)
print("STAGE 4 — NSGA-II PARETO: fluid counts, env objective, power range")
print("="*78)

_nsga_pass = True
_nsga_issues = []

# GWP dictionary must match optimization.py
_fluid_gwp = {
    "R245fa": 1030, "R1233zd(E)": 4.5, "R1234ze(E)": 7,
    "n-Pentane": 5, "Toluene": 3, "Cyclohexane": 2,
}

try:
    pareto = pd.read_csv(os.path.join(RESULTS, "06_pareto_front.csv"))

    counts = pareto["fluid"].value_counts()
    total_sols = len(pareto)
    print(f"  Total Pareto solutions: {total_sols}")
    for fluid, cnt in counts.items():
        print(f"    {fluid}: {cnt} ({100*cnt/total_sols:.1f}%)")

    # Check that ALL solutions are non-dominated by verifying:
    #   no solution has WORSE W_net AND WORSE lifecycle_cost AND WORSE env_score
    #   than another solution simultaneously (approximate; just flag if any pair dominates)
    dominated_count = 0
    F = pareto[["W_net_kW", "lifecycle_cost_USD", "env_impact_score"]].values
    for i in range(len(F)):
        for j in range(len(F)):
            if i == j:
                continue
            # j dominates i if j is strictly better on all objectives
            # (higher W_net, lower cost, lower env_score)
            if (F[j, 0] >= F[i, 0] and F[j, 1] <= F[i, 1] and F[j, 2] <= F[i, 2] and
                (F[j, 0] > F[i, 0] or F[j, 1] < F[i, 1] or F[j, 2] < F[i, 2])):
                dominated_count += 1
                break
    # Note: approximate O(n^2) check; a tolerance of 1 kW / $1k / 1 unit is acceptable
    pareto_ok = dominated_count == 0
    if not pareto_ok:
        _nsga_pass = False
        _nsga_issues.append(f"{dominated_count} Pareto solutions appear dominated")
    print(f"  [{'PASS' if pareto_ok else 'FAIL'}] All {total_sols} solutions are "
          f"non-dominated ({dominated_count} dominated found)")

    # Check env_impact_score = GWP * W_net * 4.0 (formula from optimization.py line ~350)
    pareto["_env_expected"] = pareto.apply(
        lambda r: _fluid_gwp.get(r["fluid"], np.nan) * r["W_net_kW"] * 4.0, axis=1
    )
    pareto["_env_err"] = (pareto["env_impact_score"] - pareto["_env_expected"]).abs()
    max_env_err = pareto["_env_err"].max()
    env_formula_ok = max_env_err < 1.0   # 1 kgCO2e tolerance
    if not env_formula_ok:
        _nsga_pass = False
        _nsga_issues.append(f"env_impact_score formula: max error {max_env_err:.2f}")
    print(f"  [{'PASS' if env_formula_ok else 'FAIL'}] env_score = GWP × W_net × 4.0 "
          f"(max err {max_env_err:.3f})")

    # Power range check
    W_min = pareto["W_net_kW"].min()
    W_max = pareto["W_net_kW"].max()
    print(f"  W_net range: [{W_min:.1f}, {W_max:.1f}] kW "
          f"(canonical [435, 790] kW — STALE after fluid set expansion)")

    # Note dominant fluid change
    dominant_fluid = counts.idxmax()
    dominant_pct = 100 * counts.max() / total_sols
    print()
    print(f"  NOTE (RESULT CHANGED): dominant Pareto fluid = {dominant_fluid} "
          f"({dominant_pct:.0f}% of solutions).")
    print("  CANONICAL_FACTS states '98/100 n-pentane' — this is stale because:")
    print("  1. Toluene + Cyclohexane were added to the candidate set per ACTION_PLAN.")
    print("  2. Cyclohexane (GWP=2) now dominates on the env objective.")
    print("  3. n-pentane (GWP=5) is absent from the new Pareto front entirely.")
    print("  CANONICAL_FACTS NSGA-II section + all manuscript NSGA-II narratives")
    print("  must be updated before any submission.")

    print(f"\n  Stage 4 overall: {'PASS' if _nsga_pass else 'FAIL — see issues'}")
    if _nsga_issues:
        for issue in _nsga_issues:
            print(f"    ISSUE: {issue}")

except FileNotFoundError:
    print("  [SKIP] 06_pareto_front.csv not found")
    _nsga_pass = False

# ============================================================================
# STAGE 5 — VOYAGE PROFILE (08b_voyage_weighted_performance.csv)
# Check toluene rows exist; recompute W_avg from 02b ORC data; verify CO2.
# ============================================================================
print()
print("="*78)
print("STAGE 5 — VOYAGE PROFILE: toluene present, W_avg recomputed from 02b")
print("="*78)

_voy_pass = True
_voy_issues = []

APPROACH_K = 9.0
TOTAL_HOURS = 168.0

IC_SCHEDULE = [   # (hours_per_week, load_pct, whr_active)
    (48.0,   0.0, False),   # port
    ( 8.0,  30.0, True),    # maneuvering
    (72.0,  65.0, True),    # coastal
    (40.0,  80.0, True),    # open ocean
]
LH_SCHEDULE = [
    (16.0,   0.0, False),
    ( 4.0,  30.0, True),
    (13.6,  65.0, True),
    (134.4, 80.0, True),
]

try:
    voy = pd.read_csv(os.path.join(RESULTS, "08b_voyage_weighted_performance.csv"))
    orc02b = pd.read_csv(os.path.join(RESULTS, "02b_orc_optimal_per_fluid.csv"))

    tol_rows = voy[voy["WHR_technology"] == "ORC_Toluene"]
    if len(tol_rows) == 0:
        _voy_pass = False
        _voy_issues.append("No ORC_Toluene rows in 08b_voyage_weighted_performance.csv")
        print("  [FAIL] ORC_Toluene rows absent (C6 not resolved)")
    else:
        print(f"  [PASS] ORC_Toluene rows present ({len(tol_rows)} rows)")

        # --- Recompute W_avg independently from 02b ORC data ---
        tol_02b = orc02b[orc02b["fluid_key"] == "Toluene"].sort_values("engine_load_pct")
        loads_02b = tol_02b["engine_load_pct"].values
        W_02b = tol_02b["W_net_kW"].values

        def _voyage_W_avg(schedule):
            """Time-weighted average power; inactive phases contribute 0."""
            W_sum = 0.0
            for h, l, active in schedule:
                if not active:
                    continue
                W = float(np.interp(l, loads_02b, W_02b))
                W_sum += (h / TOTAL_HOURS) * W
            return W_sum

        W_IC_expected = _voyage_W_avg(IC_SCHEDULE)
        W_LH_expected = _voyage_W_avg(LH_SCHEDULE)

        for profile, expected in [("Indian_coastal", W_IC_expected),
                                   ("Long_haul_PG_SGP", W_LH_expected)]:
            row = tol_rows[tol_rows["profile"] == profile]
            if len(row) == 0:
                _voy_pass = False
                _voy_issues.append(f"ORC_Toluene row for {profile} not found")
                print(f"  [FAIL] ORC_Toluene row missing for {profile}")
                continue
            W_csv = float(row["W_whr_avg_kW"].iloc[0])
            err_pct = abs(W_csv - expected) / expected * 100
            W_ok = err_pct < 0.5   # 0.5% tolerance on schedule arithmetic
            if not W_ok:
                _voy_pass = False
                _voy_issues.append(
                    f"{profile} W_avg CSV={W_csv:.2f}, expected={expected:.2f} kW "
                    f"(err {err_pct:.2f}%)")
            print(f"  [{'PASS' if W_ok else 'FAIL'}] {profile} ORC_Toluene W_avg: "
                  f"CSV={W_csv:.2f} kW, first-principles={expected:.2f} kW "
                  f"(diff {err_pct:.3f}%)")

        # Sanity: W_avg << design-point 684 kW due to port time and low-load phases
        for profile, sched in [("Indian_coastal", IC_SCHEDULE),
                                ("Long_haul_PG_SGP", LH_SCHEDULE)]:
            W_avg = _voyage_W_avg(sched)
            row = tol_rows[tol_rows["profile"] == profile]
            if len(row) == 0:
                continue
            W_csv = float(row["W_whr_avg_kW"].iloc[0])
            below_design = W_csv < 684.0
            if not below_design:
                _voy_pass = False
                _voy_issues.append(f"{profile} W_avg={W_csv:.1f} >= design 684 kW (implausible)")
            print(f"  [{'PASS' if below_design else 'FAIL'}] {profile} W_avg={W_csv:.1f} "
                  f"< design 684 kW (physically expected)")

    # Note: canonical 296/412 kW were Steam_Rankine values (C6 defect)
    sr_rows = voy[voy["WHR_technology"] == "Steam_Rankine"]
    sr_IC = sr_rows[sr_rows["profile"] == "Indian_coastal"]["W_whr_avg_kW"].iloc[0] \
            if len(sr_rows[sr_rows["profile"] == "Indian_coastal"]) > 0 else np.nan
    sr_LH = sr_rows[sr_rows["profile"] == "Long_haul_PG_SGP"]["W_whr_avg_kW"].iloc[0] \
            if len(sr_rows[sr_rows["profile"] == "Long_haul_PG_SGP"]) > 0 else np.nan
    print()
    print(f"  NOTE (STALE CANONICAL): CANONICAL_FACTS voyage 296/412 kW are Steam_Rankine")
    print(f"  values (confirmed: {sr_IC:.1f}/{sr_LH:.1f} kW in CSV).")
    print(f"  ORC_Toluene voyage values in rebuilt CSV are significantly higher.")
    print(f"  All manuscript voyage paragraphs must cite ORC_Toluene, not Steam_Rankine.")

    print(f"\n  Stage 5 overall: {'PASS' if _voy_pass else 'FAIL'}")
    if _voy_issues:
        for issue in _voy_issues:
            print(f"    ISSUE: {issue}")

except FileNotFoundError as e:
    print(f"  [SKIP] Required CSV not found: {e}")
    _voy_pass = False

# ============================================================================
# STAGE 6 — MONTE CARLO (05_monte_carlo_results.csv)
# Recompute mean/CI from CSV; compare to canonical 461 kW / [337, 620] kW.
# ============================================================================
print()
print("="*78)
print("STAGE 6 — MONTE CARLO: N, mean, CI, NPV, payback vs canonical")
print("="*78)

_mc_pass = True
_mc_issues = []

# Canonical targets (CANONICAL_FACTS.md — not modified):
MC_MEAN_KW    = 461.0
MC_STD_KW     = 73.0
MC_CI_LO_KW   = 337.0
MC_CI_HI_KW   = 620.0
MC_NPV_FRAC   = 1.00    # 100% of scenarios NPV positive
MC_NPV_MEAN   = 3.93e6  # USD
MC_PAYBACK_MED = 2.4    # years

try:
    mc = pd.read_csv(os.path.join(RESULTS, "05_monte_carlo_results.csv"))
    W = mc["W_net_kW"].values
    N = len(W)

    # N
    N_ok = N == 15000
    if not N_ok:
        _mc_pass = False
        _mc_issues.append(f"N={N}, expected 15 000")
    print(f"  [{'PASS' if N_ok else 'FAIL'}] N = {N} (expected 15 000)")

    # Mean
    mean_W = W.mean()
    mean_ok = abs(mean_W - MC_MEAN_KW) < 5.0   # ±5 kW (< 1.1%)
    if not mean_ok:
        _mc_pass = False
        _mc_issues.append(f"Mean W_net={mean_W:.1f} kW vs canonical {MC_MEAN_KW:.1f} kW")
    print(f"  [{'PASS' if mean_ok else 'FAIL'}] Mean W_net = {mean_W:.1f} kW "
          f"(canonical {MC_MEAN_KW:.0f}, diff {mean_W-MC_MEAN_KW:+.1f})")

    # Std
    std_W = W.std()
    std_ok = abs(std_W - MC_STD_KW) < 5.0
    if not std_ok:
        _mc_pass = False
        _mc_issues.append(f"Std W_net={std_W:.1f} kW vs canonical {MC_STD_KW:.1f} kW")
    print(f"  [{'PASS' if std_ok else 'FAIL'}] Std W_net = {std_W:.1f} kW "
          f"(canonical {MC_STD_KW:.0f})")

    # 95% CI
    ci_lo = np.percentile(W, 2.5)
    ci_hi = np.percentile(W, 97.5)
    ci_ok = abs(ci_lo - MC_CI_LO_KW) < 10.0 and abs(ci_hi - MC_CI_HI_KW) < 10.0
    if not ci_ok:
        _mc_pass = False
        _mc_issues.append(f"95% CI=[{ci_lo:.0f}, {ci_hi:.0f}] kW vs canonical [{MC_CI_LO_KW:.0f}, {MC_CI_HI_KW:.0f}]")
    print(f"  [{'PASS' if ci_ok else 'FAIL'}] 95% CI = [{ci_lo:.1f}, {ci_hi:.1f}] kW "
          f"(canonical [{MC_CI_LO_KW:.0f}, {MC_CI_HI_KW:.0f}])")

    # NPV positive fraction
    NPV = mc["NPV_20yr_USD"].values
    npv_pos_frac = (NPV > 0).mean()
    npv_ok = npv_pos_frac >= 0.99   # 99% threshold (canonical says 100%)
    if not npv_ok:
        _mc_pass = False
        _mc_issues.append(f"NPV positive fraction = {100*npv_pos_frac:.1f}% (expected 100%)")
    print(f"  [{'PASS' if npv_ok else 'FAIL'}] NPV positive = {100*npv_pos_frac:.1f}% "
          f"(canonical 100%)")

    # Mean NPV
    mean_npv = NPV.mean()
    npv_mean_ok = abs(mean_npv - MC_NPV_MEAN) / MC_NPV_MEAN < 0.05   # ±5%
    if not npv_mean_ok:
        _mc_pass = False
        _mc_issues.append(f"Mean NPV=${mean_npv/1e6:.2f}M vs canonical ${MC_NPV_MEAN/1e6:.2f}M")
    print(f"  [{'PASS' if npv_mean_ok else 'FAIL'}] Mean NPV = ${mean_npv/1e6:.2f}M "
          f"(canonical ${MC_NPV_MEAN/1e6:.2f}M)")

    # Median payback
    PB = mc["payback_years"].values
    med_pb = np.median(PB)
    pb_ok = abs(med_pb - MC_PAYBACK_MED) < 0.2   # ±0.2 yr
    if not pb_ok:
        _mc_pass = False
        _mc_issues.append(f"Median payback={med_pb:.2f} yr vs canonical {MC_PAYBACK_MED:.1f} yr")
    print(f"  [{'PASS' if pb_ok else 'FAIL'}] Median payback = {med_pb:.2f} yr "
          f"(canonical {MC_PAYBACK_MED:.1f})")

    print(f"\n  Stage 6 overall: {'PASS' if _mc_pass else 'FAIL'}")
    if _mc_issues:
        for issue in _mc_issues:
            print(f"    ISSUE: {issue}")

except FileNotFoundError:
    print("  [SKIP] 05_monte_carlo_results.csv not found")
    _mc_pass = False

# ============================================================================
